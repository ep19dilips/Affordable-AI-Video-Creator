# ---- Core ----
PORT=8080
JWT_SECRET=change_me_to_a_long_random_string
NODE_ENV=development

# Railway auto-injects these when you attach Postgres/Redis plugins:
DATABASE_URL=postgres://user:pass@host:5432/railway
REDIS_URL=redis://default:pass@host:6379

# ---- Storage (Cloudflare R2 stays cheap/zero-egress regardless of compute host) ----
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=idea2video-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Auth ----
GOOGLE_OAUTH_CLIENT_ID=

# ---- AI Providers ----
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=
PEXELS_API_KEY=
SERPER_API_KEY=

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
