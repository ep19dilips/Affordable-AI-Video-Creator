{
  "name": "idea2video-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start:server": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "db:migrate": "psql $DATABASE_URL -f ../infra/migrations/0001_init.sql",
    "db:seed": "psql $DATABASE_URL -f ../infra/seed/seed.sql"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "pg": "^8.13.0",
    "bullmq": "^5.21.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "fluent-ffmpeg": "^2.1.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.10",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^22.0.0"
  }
}